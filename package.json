{
  "name": "dsh-simple-ui",
  "version": "1.0.0",
  "description": "A persistent industrial-style appearance skin and real DSH UI enhancements.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "license": "MIT"
}
